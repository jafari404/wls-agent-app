<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ورود پشتیبان"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/editUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="نام‌کاربری وردپرس" />

    <EditText
        android:id="@+id/editAppPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Application Password"
        android:inputType="textPassword"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#777777"
        android:textSize="12sp"
        android:text="این رمز عبور اصلی وردپرس شما نیست. آن را از پروفایل کاربری خود در wp-admin، بخش Application Passwords بسازید." />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ورود" />

</LinearLayout>
